{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coursecraft.page_kit/1",
  "title": "CourseCraft Page Kit",
  "type": "object",
  "required": [
    "schema",
    "kit_id",
    "title",
    "status",
    "delivery_surface",
    "theme",
    "page_types",
    "supported_block_kinds",
    "supported_creatorplus_modes",
    "lifecycle",
    "extensions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "coursecraft.page_kit/1"},
    "kit_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["experimental", "supported", "retired"]},
    "delivery_surface": {"const": "brightspace_html_topic"},
    "theme": {"$ref": "#/$defs/theme"},
    "page_types": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pageType"}
    },
    "supported_block_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/blockKind"}
    },
    "supported_creatorplus_modes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/creatorMode"}
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "blocking_review_states",
        "raw_html_policy",
        "creatorplus_provider_policy",
        "extensions"
      ],
      "additionalProperties": false,
      "properties": {
        "blocking_review_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["unresolved", "ready_for_review"]}
        },
        "raw_html_policy": {"enum": ["allow", "warn", "block"]},
        "creatorplus_provider_policy": {
          "enum": ["provider_backed_required", "local_payload_allowed"]
        },
        "extensions": {"type": "object", "additionalProperties": true}
      }
    },
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "blockKind": {
      "enum": [
        "prose",
        "outcomes",
        "video",
        "disclosure",
        "route_list",
        "resources",
        "creatorplus_group",
        "callout",
        "review_note",
        "review_questions",
        "raw_html"
      ]
    },
    "creatorMode": {
      "enum": [
        "fill_in_blank_text_v1",
        "sorting_v1",
        "sequencing_v1",
        "quick_quiz_choice_v1",
        "quick_quiz_multi_select_v1"
      ]
    },
    "theme": {
      "type": "object",
      "required": ["theme_id", "tokens", "extensions"],
      "additionalProperties": false,
      "properties": {
        "theme_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "tokens": {
          "type": "object",
          "required": [
            "brand",
            "brand_dark",
            "link",
            "accent",
            "text",
            "muted",
            "border",
            "surface",
            "review",
            "review_border",
            "review_fill"
          ],
          "additionalProperties": false,
          "properties": {
            "brand": {"$ref": "#/$defs/color"},
            "brand_dark": {"$ref": "#/$defs/color"},
            "link": {"$ref": "#/$defs/color"},
            "accent": {"$ref": "#/$defs/color"},
            "text": {"$ref": "#/$defs/color"},
            "muted": {"$ref": "#/$defs/color"},
            "border": {"$ref": "#/$defs/color"},
            "surface": {"$ref": "#/$defs/color"},
            "review": {"$ref": "#/$defs/color"},
            "review_border": {"$ref": "#/$defs/color"},
            "review_fill": {"$ref": "#/$defs/color"}
          }
        },
        "extensions": {"type": "object", "additionalProperties": true}
      }
    },
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "pageType": {
      "type": "object",
      "required": ["page_type", "required_slots", "allowed_blocks", "extensions"],
      "additionalProperties": false,
      "properties": {
        "page_type": {"type": "string", "pattern": "^[a-z][a-z0-9_-]+$"},
        "required_slots": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]+$"}
        },
        "allowed_blocks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/blockKind"}
        },
        "extensions": {"type": "object", "additionalProperties": true}
      }
    }
  }
}
